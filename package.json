{
  "name": "moltbot-starter-kit",
  "version": "1.0.0",
  "description": "MultiversX Agent Starter Kit (OpenClaw + x402)",
  "main": "dist/index.js",
  "scripts": {
    "setup": "bash setup.sh",
    "build": "tsc -p tsconfig.build.json",
    "start": "node dist/index.js",
    "register": "ts-node scripts/register.ts",
    "build-manifest": "ts-node scripts/build_manifest.ts",
    "pin-manifest": "ts-node scripts/pin_manifest.ts",
    "update-agent": "ts-node scripts/update_agent.ts",
    "submit-job-proof": "ts-node scripts/submit-job-proof.ts",
    "employer-flow": "ts-node scripts/employer_flow.ts",
    "validation-request": "ts-node scripts/validation-request.ts",
    "validation-response": "ts-node scripts/validation-response.ts",
    "generate-wallet": "ts-node scripts/generate_wallet.ts",
    "check-balance": "ts-node scripts/check_balance.ts",
    "fund": "ts-node scripts/fund.ts",
    "get-chain-id": "ts-node scripts/get_chain_id.ts",
    "pull-skill": "ts-node scripts/pull_skill.ts",
    "upload-skill": "ts-node scripts/upload_skill.ts",
    "sign-tx": "ts-node scripts/sign_tx.ts",
    "sign-x402": "ts-node scripts/sign_x402.ts",
    "test": "jest",
    "test:coverage": "jest --coverage",
    "lint": "gts lint",
    "format": "prettier --write .",
    "clean": "gts clean",
    "compile": "tsc -p tsconfig.build.json",
    "fix": "gts fix",
    "prepare": "husky && npm run compile",
    "pretest": "npm run compile",
    "posttest": "npm run lint"
  },
  "lint-staged": {
    "*.{ts,js,tsx,jsx,json,md,yml,yaml}": "prettier --write",
    "*.{ts,js,tsx,jsx}": "gts fix"
  },
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.29.0",
    "@multiversx/sdk-core": "^15.3.2",
    "@multiversx/sdk-network-providers": "^2.9.3",
    "@multiversx/sdk-wallet": "^4.6.0",
    "@noble/hashes": "^1.3.0",
    "axios": "^1.6.0",
    "better-sqlite3": "^13.0.3",
    "dotenv": "^16.3.1"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^9.6.0",
    "@types/jest": "^29.0.0",
    "@types/node": "^22.7.5",
    "eslint": "^9.39.2",
    "gts": "^7.0.0",
    "husky": "^9.1.7",
    "jest": "^29.0.0",
    "lint-staged": "^17.3.0",
    "prettier": "^3.9.6",
    "ts-jest": "^29.0.0",
    "ts-node": "^10.9.1",
    "typescript": "^5.6.3"
  }
}
