# ⚠️  SECURITY: NEVER commit .env with real private keys or secrets.
#    Copy this file to .env (already gitignored) and fill in your values.
#    Keep wallet.pem and any *.pem files out of version control.

# ─── Wallet ───────────────────────────────────────────────────────────────────
MULTIVERSX_PRIVATE_KEY=wallet.pem

# ─── Network ──────────────────────────────────────────────────────────────────
MULTIVERSX_CHAIN_ID=D
MULTIVERSX_API_URL=https://devnet-api.multiversx.com
MULTIVERSX_EXPLORER_URL=https://devnet-explorer.multiversx.com

# ─── Registry / Contract Addresses ────────────────────────────────────────────
IDENTITY_REGISTRY_ADDRESS=erd1qqqqqqqqqqqqqpgqxyum8w6cn6xkz9q5rsy4mfcsw3njpd6cd8ssr4quyy
VALIDATION_REGISTRY_ADDRESS=erd1qqqqqqqqqqqqqpgqvax6z79cvyz9gkfwg57hqume352p7s7rd8ss4g3t43
REPUTATION_REGISTRY_ADDRESS=
ESCROW_CONTRACT_ADDRESS=

# ─── External Services ────────────────────────────────────────────────────────
MCP_ENABLED=false
MULTIVERSX_MCP_URL=http://localhost:3000
# When MCP is enabled, reject jobs if counterparty score is below this (0 = off)
MCP_MIN_REPUTATION=0
# Comma-separated tools allowed for meta.mcpTool (* = any). Empty = reject mcpTool jobs.
MCP_ALLOWED_TOOLS=
MULTIVERSX_RELAYER_URL=http://localhost:3001
# Optional: explicit relayer address. If unset, discovered via /relayer/address/<sender>
MULTIVERSX_RELAYER_ADDRESS=
X402_FACILITATOR_URL=http://localhost:4000

# Strict production checks (also on when NODE_ENV=production)
MOLTBOT_STRICT_CONFIG=false

# Persistent job ledger (idempotency across restarts)
JOB_STORE_PATH=.moltbot/jobs.db
JOB_STALE_MS=600000
# After successful proof, call escrow.release when ESCROW_CONTRACT_ADDRESS is set
ESCROW_AUTO_RELEASE=false

# ─── Security ─────────────────────────────────────────────────────────────────
ALLOWED_DOMAINS=example.com,jsonplaceholder.typicode.com
# Local-dev only: accept facilitator poll events without /payments verification
ALLOW_UNVERIFIED_PAYMENTS=false
# Local-dev only: validation scripts may self-sign as the oracle
MOCK_VALIDATION=false

# ─── Agent Identity (used for auto-registration) ──────────────────────────────
AGENT_NAME=moltbot
# Live HTTP base for on-chain agent.uri (template public URL). Not IPFS.
AGENT_URI=http://localhost:3000

# ─── Gas / Relayer Settings ───────────────────────────────────────────────────
GAS_LIMIT_REGISTER_AGENT=6000000
RELAYER_GAS_OVERHEAD=50000

# ─── Timeouts & Retries ───────────────────────────────────────────────────────
REQUEST_TIMEOUT=10000
RETRY_MAX_ATTEMPTS=5
RETRY_SUBMISSION_DELAY=10000
RETRY_CHECK_INTERVAL=2000

# ─── Concurrency & Rate Limiting ──────────────────────────────────────────────
# Max parallel jobs the agent will process at once (1 = serial, safe for shared nonce)
MAX_JOB_CONCURRENCY=1
# Max jobs per caller per minute before rate-limiting kicks in
RATE_LIMIT_MAX_JOBS_PER_MIN=20
# Max concurrent MCP tool calls (prevents fd exhaustion)
MCP_MAX_CONCURRENT=10

# ─── Employer Role (used by scripts/employer_flow.ts) ─────────────────────────
EMPLOYER_PEM_PATH=
EMPLOYER_ADDRESS=
# Which on-chain agent (by nonce) the employer hires, and which of its services.
AGENT_NONCE=1
AGENT_SERVICE_ID=inference
# Reputation rating (1-5) submitted after the worker completes the job.
JOB_RATING=5

# ─── Validation flow scripts (validation-request / validation-response) ───────
VALIDATOR_ADDRESS=
VALIDATOR_PEM_PATH=

# ─── Logging ──────────────────────────────────────────────────────────────────
# Set to "json" to emit structured JSON logs (auto-on in production)
LOG_FORMAT=

# ─── Misc script overrides ────────────────────────────────────────────────────
# Force scripts/register.ts to use the relayer even when the wallet has balance.
FORCE_RELAYER=

# ─── IPFS Pinning (used by scripts/pin_manifest.ts) ───────────────────────────
PINATA_API_KEY=
PINATA_SECRET=

# ─── ClawHub Skill Upload (used by scripts/upload_skill.ts) ───────────────────
# Required for real publish (not needed for --dry-run):
CLAWHUB_TOKEN=
# Optional API base URL override:
CLAWHUB_REGISTRY=https://clawhub.ai
# Optional defaults for deploy script:
CLAWHUB_SKILL_PATH=.
CLAWHUB_SLUG=
CLAWHUB_NAME=
CLAWHUB_VERSION=
CLAWHUB_CHANGELOG=
CLAWHUB_TAGS=latest
# Set true to preview payload/files without uploading:
CLAWHUB_DRY_RUN=false
